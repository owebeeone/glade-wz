{
  "version": 1,
  "packages": {
    "glade-raft-adoption-api": {
      "role": "contract",
      "dependencies": [],
      "traits": {
        "CommittedMachine": [
          "apply",
          "lookup"
        ]
      },
      "conformance_tests": [
        "public_contract"
      ]
    },
    "glade-raft-adoption-proof": {
      "role": "harness",
      "reason": "Accepted Q3 allocation: controlled actual-Raft harness implements the private QualificationSession consuming q3-api and injected StoreLifecycle; concrete disk remains dev-only. Q1a/Q2 contracts remain preserved. Concrete Q3 implementation and complete qualification evidence are pending Code/State review.",
      "dependencies": [
        "normal:glade-raft-adoption-api",
        "normal:raft",
        "normal:protobuf",
        "normal:slog",
        "normal:glade-raft-durability-api",
        "dev:glade-raft-disk",
        "normal:glade-raft-q3-api"
      ],
      "conformance_tests": [
        "qualification",
        "recovery",
        "q3_fixture_compatibility"
      ],
      "implements": [
        {
          "package": "glade-raft-q3-api",
          "trait": "QualificationSession",
          "type": "q3::Q3Session"
        }
      ]
    },
    "glade-raft-durability-api": {
      "role": "contract",
      "dependencies": [],
      "traits": {
        "DurableStore": [
          "load",
          "persist"
        ]
      },
      "conformance_tests": [
        "public_contract"
      ]
    },
    "glade-raft-disk": {
      "role": "implementation",
      "dependencies": [
        "normal:glade-raft-durability-api",
        "normal:glade-raft-q3-api"
      ],
      "implements": [
        {
          "package": "glade-raft-durability-api",
          "trait": "DurableStore",
          "type": "DiskStore"
        },
        {
          "package": "glade-raft-q3-api",
          "trait": "CheckpointStore",
          "type": "v2::V2DiskStore"
        },
        {
          "package": "glade-raft-q3-api",
          "trait": "StoreLifecycle",
          "type": "v2::V2StoreFactory"
        }
      ],
      "conformance_tests": [
        "conformance",
        "v2_lifecycle"
      ],
      "reason": "Accepted Q3 allocation: isolated V2 modules implement CheckpointStore and injected owned-path StoreLifecycle; Q2 format/contract remain preserved. Concrete implementation is pending Code/State review."
    },
    "glade-raft-q3-api": {
      "role": "contract",
      "reason": "Accepted private Q3 store/session contract and reviewed smallest injected create/open lifecycle supplement; no carrier/path implementation types or production adoption.",
      "dependencies": [
        "normal:glade-raft-adoption-api",
        "normal:glade-raft-durability-api"
      ],
      "traits": {
        "CheckpointStore": [
          "load",
          "publish"
        ],
        "QualificationSession": [
          "control",
          "view",
          "configure",
          "configuration_outcome",
          "submit",
          "outcome",
          "resource",
          "checkpoint",
          "install",
          "applied_entry",
          "replay"
        ],
        "StoreLifecycle": [
          "create",
          "open"
        ]
      },
      "conformance_tests": [
        "public_contract"
      ]
    },
    "glade-raft-q3-spec": {
      "role": "harness",
      "reason": "Accepted Q3 allocation: reusable normal consumer depends only on q3-api; dev-only integration composition selects actual carrier and filesystem providers. All nineteen original default specifications remain selected against concrete providers; full implementation is pending Code/State review. No production dependency path.",
      "dependencies": [
        "normal:glade-raft-q3-api",
        "dev:glade-raft-adoption-proof",
        "dev:glade-raft-disk"
      ],
      "conformance_tests": [
        "configuration_snapshot"
      ]
    }
  }
}
